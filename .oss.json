{
  "repo": "jbkkz/requivo",
  "default_branch": "main",
  "branch_pattern": "fix/{issue}",
  "test_command": "uv run --extra dev pytest -q",
  "version_sites": [
    "pyproject.toml",
    "CHANGELOG.md"
  ],
  "changelog_dir": "changelog.d",
  "changelog_untagged": ["0.6.1"],
  "docs_targets": [
    "README.md"
  ],
  "labels": {
    "priority": ["priority-blocker", "priority-high", "priority-low"],
    "lanes": ["lane-core", "lane-services", "lane-providers", "lane-surfaces", "lane-tests", "lane-infra"]
  },
  "milestones": [],
  "release": {
    "tag_pattern": "v{version}",
    "merge_method": null,
    "commit_subject": null,
    "triggers": {
      "merged_prs": 10,
      "soak_hours": 48
    }
  }
}
